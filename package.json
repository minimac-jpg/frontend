{
  "name": "maple-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-vm-modules rsbuild dev",
    "build": "tsc -b && rsbuild build",
    "preview": "rsbuild preview",
    "test": "vitest run",
